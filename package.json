{
  "name": "tron-multisig-desktop",
  "version": "1.0.0",
  "description": "TRON MultiSig Desktop Client",
  "author": "rockytown101-sketch",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --arm64 --publish never"
  },
  "dependencies": {
    "express": "^4.18.2",
    "tronweb": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tron.multisig.desktop",
    "productName": "TRON MultiSig Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
