{
  "name": "tron-multisig-desktop",
  "version": "1.0.0",
  "description": "Industrial TRON MultiSig Desktop Management Suite",
  "main": "src/main/index.js",
"scripts": {
  "start": "electron .",
  "build": "electron-builder --win nsis --x64 --arm64 --publish never"
}
  },
  "dependencies": {
    "express": "^4.18.2",
    "tronweb": "^5.3.0"
  },
